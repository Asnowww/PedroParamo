	"ops": [
		{"title": "第三章 · 塌了一半的屋顶"},
		{"bg": "present_carretas_01"},
		{"who": "", "text": "假嗓的歌声近了。我看见几辆牛车过去，拉车的公牛慢悠悠地走，车上的人像在睡觉。"},
		{"who": "母亲的声音", "text": "（每天清晨，牛车一来，村庄就颤动起来。这时人们打开炉灶，新烤的面包发出香味……你会对许多突然发生的事习以为常的，我的孩子。）"},
		{"who": "", "text": "空荡荡的牛车消失在夜路上。我想回去了——山上还留着我来时的足迹，像一处处伤口。"},
		{"whisper": 0.04},
		{"bg": "present_donis_ext_01"},
		{"who": "", "text": "有人拍了拍我的肩膀。"},
		{"meet": "多尼斯"},
		{"who": "多尼斯", "text": "您在这儿干什么？"},
		{"who": "我", "text": "我是来找……我是来找我父亲的。"},
		{"who": "多尼斯", "text": "您为什么不进去？"},
		{"bg": "present_donis_01"},
		{"meet": "多尼斯的姐姐"},
		{"who": "", "text": "屋顶塌了一半的房子，地上满是碎砖破瓦。住着一男一女。"},
		{"who": "我", "text": "……您们不是死人吧？"},
		{"who": "", "text": "女人笑了。男人板着脸瞪了我一眼。"},
		{"who": "多尼斯", "text": "他醉了。"},
		{"who": "多尼斯的姐姐", "text": "他只是受了点惊。"},
